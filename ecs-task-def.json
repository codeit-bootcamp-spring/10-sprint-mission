{
  "family": "${ECS_TASK_DEFINITION}",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "networkMode": "bridge",
  "cpu": "512",
  "memory": "819",
  "containerDefinitions": [
    {
      "name": "discodeit-app",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/discodeit:${IMAGE_TAG}",
      "cpu": 512,
      "memory": 819,
      "memoryReservation": 410,
      "portMappings": [
        {
          "name": "discodeit-app-80-tcp",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environmentFiles": [
        {
          "value": "arn:aws:s3:::discodeit-binary-content-storage-plzslp/config/discodeit.env",
          "type": "s3"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/discodeit-task",
          "awslogs-create-group": "true",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}