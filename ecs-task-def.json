{
  "family": "discodeit-task",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "cpu": "256",
  "memory": "512",

  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",

  "containerDefinitions": [
    {
      "name": "discodeit-app",

      "image": "${REPO_URI}:${IMAGE_TAG}",

      "cpu": 256,
      "memory": 384,
      "memoryReservation": 256,

      "essential": true,

      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],

      "environment": [],

      "environmentFiles": [
        {
          "value": "arn:aws:s3:::discodeit-binary-content-storage-kis/discodeit.env",
          "type": "s3"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/discodeit-task",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}