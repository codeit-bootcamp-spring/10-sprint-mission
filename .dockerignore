# Git
.git
.gitignore

# Gradle 캐시
.gradle/

# 빌드 결과물
build/
# <- build 제외하되 jar 파일은 포함 (jar 파일은 Docker 이미지 빌드에 필요함)
!build/libs/*.jar

# IDE
.idea/

# Documentation
README.md
HELP.md
CLAUDE.md
*.md

# Tests
src/test/

# Development configuration
src/main/resources/application-dev.yaml

# GitHub
.github/

# etc
api-docs_1.2.json
src/main/resources/fe_bundle_1.2.3.zip

# === .dockerignore ===
# Docker 이미지 빌드 시 불필요한 파일을 제외시키는 파일
# -> Docker 이미지에 포함하지 않을 파일 목록

# docker build 실행 시 현재 폴더의 모든 파일을 Docker에 전송
# 이때 불필요한 파일까지 포함되면
# -> 이미지 크기 증가, 빌드 속도 느려짐, 보안 위험 등이 존재함

# 빌드 결과물, IDE 설정 파일, Git 관련, 환경변수 파일, 테스트 관련 내용을 일반적으로 제외한다.