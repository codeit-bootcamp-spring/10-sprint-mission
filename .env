# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database 설정
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/discodeit
SPRING_DATASOURCE_USERNAME=discodeit_user
SPRING_DATASOURCE_PASSWORD=discodeit1234

# JVM 옵션 (필요하면 나중에 수정)
JVM_OPTS=

APP_PORT=8081

# Postgres 설정 - docker-compose용
POSTGRES_DB=discodeit
POSTGRES_USER=discodeit_user
POSTGRES_PASSWORD=discodeit1234
POSTGRES_PORT=5432